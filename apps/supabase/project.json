{
  "name": "supabase",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/supabase/functions",
  "tags": ["scope:backend", "platform:supabase"],
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "npx supabase start --workdir apps" }
    },
    "stop": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "npx supabase stop --project-id Impulso --workdir apps" }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "npx supabase migration up --local --workdir apps" }
    },
    "configure-backend": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node apps/supabase/scripts/configure-backend.mjs" }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build-auth"],
      "options": {
        "command": "npx supabase functions serve --env-file apps/supabase/functions/.env.local --workdir apps"
      }
    },
    "build-auth": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/functions/impulso-auth/browser/**/*", "{projectRoot}/scripts/build-auth.mjs"],
      "outputs": ["{projectRoot}/functions/impulso-auth/_generated"],
      "options": { "command": "node apps/supabase/scripts/build-auth.mjs" }
    },
    "build-site": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/apps/impulso-auth"],
      "options": { "command": "node apps/supabase/scripts/build-auth.mjs static" }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["build-auth"],
      "options": {
        "command": "npx deno check --config apps/supabase/functions/impulso-api/deno.json apps/supabase/functions/impulso-api/index.ts apps/supabase/functions/impulso-auth/index.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "npx deno lint --no-config --ignore=apps/supabase/functions/impulso-auth/browser,apps/supabase/functions/impulso-auth/_generated apps/supabase/functions apps/supabase/scripts"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx deno fmt --no-config --line-width=100 --ignore=apps/supabase/functions/impulso-auth/browser,apps/supabase/functions/impulso-auth/_generated apps/supabase/functions apps/supabase/scripts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "commands": [
          "npx deno test --config apps/supabase/functions/impulso-api/deno.json --allow-env apps/supabase/functions/_shared apps/supabase/functions/impulso-api apps/supabase/functions/impulso-auth",
          "node --test apps/supabase/functions/impulso-auth/browser/client.test.mjs apps/supabase/scripts/build-auth.test.mjs"
        ],
        "parallel": false
      }
    },
    "test-db": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "npx supabase test db --local --workdir apps" }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": { "command": "node apps/supabase/scripts/run-integration.mjs" }
    },
    "verify-schema": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx supabase db schema declarative sync --file verify_impulso_schema --no-apply --workdir apps"
      }
    },
    "push-config": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx supabase config push --project-ref txoorpmblpvqveeudafv --workdir apps"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build-auth"],
      "options": {
        "command": "npx supabase functions deploy impulso-api --project-ref txoorpmblpvqveeudafv --workdir apps"
      }
    }
  }
}
