{
  "name": "supabase",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/supabase/functions",
  "tags": ["scope:backend", "platform:supabase"],
  "targets": {
    "test-db": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "options": {
        "command": "npx supabase@2.120.0 test db --local --workdir apps"
      }
    },
    "start-local": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx supabase@2.120.0 start --workdir apps",
        "envFile": "apps/supabase/.env.local"
      }
    },
    "migrate-local": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx supabase@2.120.0 migration up --local --workdir apps",
        "envFile": "apps/supabase/.env.local"
      }
    },
    "serve-functions": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build-auth"],
      "options": {
        "command": "npx supabase@2.120.0 functions serve --env-file apps/supabase/functions/.env.local --workdir apps",
        "envFile": "apps/supabase/.env.local"
      }
    },
    "check-functions": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["build-auth"],
      "options": {
        "command": "npx deno check --config apps/supabase/functions/impulso-api/deno.json apps/supabase/functions/impulso-api/index.ts apps/supabase/functions/impulso-auth/index.ts"
      }
    },
    "lint-functions": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx deno lint --no-config --ignore=apps/supabase/functions/impulso-auth/browser,apps/supabase/functions/impulso-auth/_generated apps/supabase/functions"
      }
    },
    "test-functions": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "npx deno test --config apps/supabase/functions/impulso-api/deno.json --allow-env apps/supabase/functions/_shared apps/supabase/functions/impulso-api apps/supabase/functions/impulso-auth"
      }
    },
    "test-integration": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/supabase/scripts/run-integration.mjs",
        "envFile": "apps/supabase/.env.local"
      }
    },
    "format-functions": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "options": {
        "command": "npx deno fmt --no-config --line-width=100 --ignore=apps/supabase/functions/impulso-auth/browser,apps/supabase/functions/impulso-auth/_generated apps/supabase/functions"
      }
    },
    "configure-backend": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "options": {
        "command": "node apps/supabase/scripts/configure-backend.mjs",
        "envFile": "apps/supabase/.env.local"
      }
    },
    "stop-local": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "options": {
        "command": "npx supabase@2.120.0 stop --project-id Impulso --workdir apps",
        "envFile": "apps/supabase/.env.local"
      }
    },
    "verify-schema": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "options": {
        "command": "npx supabase@2.120.0 db schema declarative sync --file verify_impulso_schema --no-apply --workdir apps",
        "envFile": "apps/supabase/.env.local"
      }
    },
    "test-auth": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "options": {
        "command": "node --test apps/supabase/functions/impulso-auth/browser/client.test.mjs apps/supabase/scripts/build-auth-static.test.mjs"
      }
    },
    "build-auth": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [
        "{workspaceRoot}/apps/supabase/functions/impulso-auth/_generated"
      ],
      "options": {
        "command": "node apps/supabase/scripts/build-auth.mjs"
      }
    },
    "build-auth-static": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/dist/apps/impulso-auth"],
      "options": {
        "command": "node apps/supabase/scripts/build-auth-static.mjs"
      }
    },
    "prepare-remote-config": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{workspaceRoot}/work/remote-setup/supabase/config.toml"],
      "options": {
        "command": "node apps/supabase/scripts/prepare-remote-config.mjs"
      }
    },
    "test-remote-config": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "options": {
        "command": "node --test apps/supabase/scripts/prepare-remote-config.test.mjs"
      }
    },
    "doctor-tunnel": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "options": {
        "command": "powershell -NoProfile -File apps/supabase/scripts/openai-tunnel.ps1 -Mode Doctor"
      }
    },
    "run-tunnel": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": [],
      "options": {
        "command": "powershell -NoProfile -File apps/supabase/scripts/openai-tunnel.ps1 -Mode Run"
      }
    }
  }
}
