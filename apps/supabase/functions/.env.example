# Local public issuer; Supabase provisions its internal URL, API keys and database URL.
IMPULSO_AUTH_ISSUER=http://127.0.0.1:54321/auth/v1
IMPULSO_MCP_RESOURCE_URL=http://127.0.0.1:54321/functions/v1/impulso-api/mcp
IMPULSO_ALLOWED_ORIGINS=http://127.0.0.1:54321
# Created locally by the configure-backend target; never use an administrator database URL here.
IMPULSO_DATABASE_URL=
